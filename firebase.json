{
  "hosting": [
    {
      "target": "main",
      "public": "web",
      "ignore": ["**/.*"],
      "headers": [
        {"source": "sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
        {"source": "index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
      ],
      "rewrites": [{"source": "/", "destination": "/index.html"}]
    },
    {
      "target": "legacy",
      "public": "web",
      "ignore": ["**/.*"],
      "headers": [
        {"source": "sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
        {"source": "index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
      ],
      "rewrites": [{"source": "/", "destination": "/index.html"}]
    }
  ]
}
